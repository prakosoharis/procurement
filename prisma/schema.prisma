generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_USER
  CORPORATE_GOVERNANCE
  BUSINESS_UNIT_PIC
  EXECUTIVE
}

enum SopStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
}

enum GoogleDriveUploadPurpose {
  CREATE_DOCUMENT
  CREATE_VERSION
}

enum GoogleDriveUploadStatus {
  PENDING
  UPLOADED
  TRANSFERRING
  FINALIZING
  COMPLETED
  FAILED
  EXPIRED
}

enum RequestStatus {
  SUBMITTED
  IN_REVIEW
  REVISION_REQUIRED
  APPROVED
  REJECTED
}

enum SubmissionConversionMode {
  CREATE_SOP
  CREATE_REVISION
}

enum FindingStatus {
  PENDING
  VALIDATED
  REJECTED
  REVISION_REQUESTED
}

enum ActionStatus {
  OPEN
  IN_PROGRESS
  DONE
  OVERDUE
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AuditEventStatus {
  PLANNED
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum AuditEventFormat {
  ONSITE
  REMOTE
  HYBRID
}

enum AuditEventAudience {
  SELECTED_PICS
  ALL_BUSINESS_UNITS
}

enum AttendanceStatus {
  INVITED
  CONFIRMED
  ATTENDED
  DECLINED
}

enum SopVersionLifecycleState {
  DRAFT
  SUBMITTED
  REFINEMENT
  VALIDATION
  APPROVED
  READY_TO_PUBLISH
  PUBLISHED
  ARCHIVED
}

enum ReviewIntervalSource {
  VERSION_OVERRIDE
  CATEGORY_CONFIGURATION
  BUSINESS_UNIT_CONFIGURATION
  SYSTEM_DEFAULT
}

enum RefinementJobStatus {
  QUEUED
  PREPARING
  RETRIEVING
  ANALYZING
  COMPLETED
  FAILED
  CANCELLED
}

enum RefinementFindingHumanStatus {
  PENDING
  ACCEPTED
  ACCEPTED_WITH_MODIFICATION
  REJECTED
  RETURNED_FOR_REFINEMENT
}

enum RefinementSessionStatus {
  NEW
  IN_PROGRESS
  WAITING_FOR_CLARIFICATION
  BLOCKED
  READY_FOR_COMPLETION
  COMPLETED
}

enum HumanRefinementFindingStatus {
  OPEN
  WAITING_FOR_CLARIFICATION
  RESOLVED
  DEFERRED
  DISMISSED
}

enum HumanRefinementFindingCategory {
  REGULATORY_MISMATCH
  INTERNAL_POLICY_CONFLICT
  PROCESS_GAP
  CONTROL_WEAKNESS
  AMBIGUOUS_WORDING
  DUPLICATE_OR_INCONSISTENT_RULE
  ROLE_AND_RESPONSIBILITY_ISSUE
  AUDIT_OR_FRAUD_RISK
  DOCUMENT_QUALITY
  OTHER
}

enum HumanRefinementSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  OBSERVATION
}

enum HumanRefinementResolutionType {
  DOCUMENT_UPDATED
  CLARIFICATION_ACCEPTED
  CONTROL_CONFIRMED
  NO_CHANGE_REQUIRED
  OTHER
}

enum HumanRefinementEvidenceType {
  DOCUMENT_EXCERPT
  REFERENCE_SOURCE
  CLARIFICATION_RESPONSE
  SUPPORTING_ATTACHMENT
  REVIEWER_NOTE
}

enum RefinementClarificationStatus {
  OPEN
  RESPONDED
  CLOSED
}

enum ValidationDecisionType {
  ACCEPTED
  ACCEPTED_WITH_MODIFICATION
  REJECTED
  RETURNED_FOR_REFINEMENT
}

enum PublishingStatus {
  NOT_READY
  READY
  IN_PROGRESS
  PUBLISHED
  FAILED
  CANCELLED
}

enum AuditReviewStatus {
  SCHEDULED
  DUE
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AiFeature {
  REFINEMENT
  CHATBOT
  EXECUTIVE_COPILOT
}

enum AiProvider {
  ANTHROPIC
  OPENAI
  ZAI
}

enum AiEventType {
  BLOCKED_SCOPE
  PROVIDER_FAILURE
  FALLBACK_USED
  INVALID_OUTPUT
  RETRY
  RATE_LIMITED
  REQUEST_CANCELLED
}

enum OrganizationStructureStatus {
  ACTIVE
  ARCHIVED
}

enum OrganizationStructureScope {
  BUSINESS_UNIT
  GROUP
}

enum OrganizationPositionStatus {
  ACTIVE
  ARCHIVED
}

enum PersonStatus {
  ACTIVE
  ARCHIVED
}

enum PositionAssignmentType {
  PERMANENT
  ACTING
}

model BusinessUnit {
  id                                String                    @id @default(cuid())
  name                              String                    @unique
  country                           String?
  groupName                         String                    @default("Unclassified")
  industry                          String                    @default("Unclassified")
  organizationGroupId               String?
  organizationGroup                 OrganizationGroup?        @relation(fields: [organizationGroupId], references: [id])
  industryId                        String?
  industryMaster                    Industry?                 @relation(fields: [industryId], references: [id])
  users                             User[]
  sops                              SopDocument[]
  requestedSopRequests              SopRequest[]              @relation("RequestedSopBusinessUnit")
  auditEvents                       AuditEvent[]
  userScopes                        UserBusinessUnitScope[]
  refinementJobs                    RefinementJob[]
  refinementSessions                RefinementSession[]
  requestedRefinementClarifications RefinementClarification[]
  auditReviews                      AuditReview[]
  aiUsages                          AiUsage[]
  aiEvents                          AiEvent[]
  aiChatConversations               AiChatConversation[]
  googleDriveFolderId               String?
  organizationStructures            OrganizationStructure[]
  organizationPositions             OrganizationPosition[]
  defaultReviewIntervalMonths       Int?
  createdAt                         DateTime                  @default(now())
}

model SopCategory {
  id                   String        @id @default(cuid())
  name                 String        @unique
  reviewIntervalMonths Int?
  isHighRisk           Boolean       @default(false)
  documents            SopDocument[]
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
}

model OrganizationGroup {
  id                     String                  @id @default(cuid())
  name                   String                  @unique
  businessUnits          BusinessUnit[]
  organizationStructures OrganizationStructure[]
  organizationPositions  OrganizationPosition[]
  sopDocuments           SopDocument[]
  createdAt              DateTime                @default(now())
}

model Industry {
  id            String         @id @default(cuid())
  name          String         @unique
  businessUnits BusinessUnit[]
  createdAt     DateTime       @default(now())
}

model User {
  id                                String                    @id @default(cuid())
  businessUnitId                    String?
  businessUnit                      BusinessUnit?             @relation(fields: [businessUnitId], references: [id])
  name                              String
  email                             String                    @unique
  passwordHash                      String
  role                              Role
  phone                             String?
  jobTitle                          String?
  locale                            String                    @default("id")
  requests                          SopRequest[]              @relation("Requester")
  convertedSubmissions              SubmissionConversion[]    @relation("SubmissionConversionActor")
  actions                           ActionItem[]              @relation("ActionOwner")
  auditLogs                         AuditLog[]
  approvedVersions                  SopVersion[]              @relation("VersionApprover")
  ownedSopDocuments                 SopDocument[]             @relation("DocumentOwner")
  requestMessages                   RequestMessage[]
  ticketNotifications               TicketNotification[]
  createdAuditEvents                AuditEvent[]              @relation("AuditEventCreator")
  auditEventParticipations          AuditEventParticipant[]
  businessUnitScopes                UserBusinessUnitScope[]   @relation("UserBusinessUnitScopes")
  grantedBusinessUnitScopes         UserBusinessUnitScope[]   @relation("BusinessUnitScopeGrantedBy")
  reviewedSopVersions               SopVersion[]              @relation("SopVersionReviewer")
  submittedSopVersions              SopVersion[]              @relation("SopVersionSubmitter")
  requestedRefinementJobs           RefinementJob[]           @relation("RefinementJobRequester")
  startedRefinementSessions         RefinementSession[]
  createdHumanRefinementFindings    HumanRefinementFinding[]
  ownedHumanRefinementFindings      HumanRefinementFinding[]  @relation("HumanRefinementFindingOwner")
  resolvedHumanRefinementFindings   HumanRefinementFinding[]  @relation("HumanRefinementFindingResolver")
  addedHumanRefinementEvidence      HumanRefinementEvidence[]
  requestedRefinementClarifications RefinementClarification[] @relation("ClarificationRequester")
  respondedRefinementClarifications RefinementClarification[] @relation("ClarificationResponder")
  closedRefinementClarifications    RefinementClarification[] @relation("ClarificationCloser")
  validationDecisions               ValidationDecision[]
  publishingRecords                 PublishingRecord[]        @relation("PublishingRecordPublisher")
  auditReviews                      AuditReview[]             @relation("AuditReviewOwner")
  aiUsages                          AiUsage[]
  aiEvents                          AiEvent[]
  aiChatConversations               AiChatConversation[]
  createdAt                         DateTime                  @default(now())
}

model OrganizationStructure {
  id                  String                     @id @default(cuid())
  scopeType           OrganizationStructureScope @default(BUSINESS_UNIT)
  businessUnitId      String?
  businessUnit        BusinessUnit?              @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  organizationGroupId String?
  organizationGroup   OrganizationGroup?         @relation(fields: [organizationGroupId], references: [id], onDelete: Restrict)
  name                String
  effectiveDate       DateTime?
  status              OrganizationStructureStatus @default(ACTIVE)
  positions           OrganizationPosition[]
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  @@index([businessUnitId, status])
  @@index([organizationGroupId, status])
}

model OrganizationPosition {
  id                  String                     @id @default(cuid())
  structureId         String
  structure           OrganizationStructure      @relation(fields: [structureId], references: [id], onDelete: Restrict)
  businessUnitId      String?
  businessUnit        BusinessUnit?              @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  organizationGroupId String?
  organizationGroup   OrganizationGroup?         @relation(fields: [organizationGroupId], references: [id], onDelete: Restrict)
  parentId            String?
  parent              OrganizationPosition?      @relation("OrganizationPositionHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children            OrganizationPosition[]     @relation("OrganizationPositionHierarchy")
  title               String
  code                String?
  description         String?
  displayOrder        Int                        @default(0)
  status              OrganizationPositionStatus @default(ACTIVE)
  assignments         PositionAssignment[]
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  @@unique([businessUnitId, code])
  @@unique([organizationGroupId, code])
  @@index([structureId, parentId, status, displayOrder])
  @@index([businessUnitId, status])
  @@index([organizationGroupId, status])
}

model Person {
  id                 String                 @id @default(cuid())
  fullName           String
  employeeIdentifier String?                @unique
  email              String?
  phone              String?
  photoUrl           String?
  firstWorkStartedAt DateTime?
  status             PersonStatus           @default(ACTIVE)
  educations         PersonEducation[]
  certifications     PersonCertification[]
  assignments        PositionAssignment[]
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([fullName])
  @@index([status])
}

model PersonEducation {
  id             String   @id @default(cuid())
  personId       String
  person         Person   @relation(fields: [personId], references: [id], onDelete: Restrict)
  institution    String
  degreeLevel    String
  fieldOfStudy   String?
  startYear      Int?
  graduationYear Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([personId])
}

model PersonCertification {
  id           String   @id @default(cuid())
  personId     String
  person       Person   @relation(fields: [personId], references: [id], onDelete: Restrict)
  name         String
  issuer       String
  credentialId String?
  issueDate    DateTime?
  expiryDate   DateTime?
  evidenceUrl  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([personId])
  @@index([expiryDate])
}

model PositionAssignment {
  id         String                 @id @default(cuid())
  positionId String
  position   OrganizationPosition   @relation(fields: [positionId], references: [id], onDelete: Restrict)
  personId   String
  person     Person                 @relation(fields: [personId], references: [id], onDelete: Restrict)
  startDate  DateTime
  endDate    DateTime?
  type       PositionAssignmentType @default(PERMANENT)
  note       String?
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  @@unique([personId, positionId, startDate])
  @@index([positionId, endDate])
  @@index([personId, endDate])
}

model UserBusinessUnitScope {
  id             String       @id @default(cuid())
  userId         String
  businessUnitId String
  createdById    String?
  user           User         @relation("UserBusinessUnitScopes", fields: [userId], references: [id], onDelete: Cascade)
  businessUnit   BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  createdBy      User?        @relation("BusinessUnitScopeGrantedBy", fields: [createdById], references: [id])
  createdAt      DateTime     @default(now())

  @@unique([userId, businessUnitId])
  @@index([businessUnitId])
  @@index([createdById])
}

model AuditEvent {
  id             String                  @id @default(cuid())
  businessUnitId String?
  businessUnit   BusinessUnit?           @relation(fields: [businessUnitId], references: [id])
  title          String
  agenda         String
  format         AuditEventFormat        @default(ONSITE)
  audience       AuditEventAudience      @default(SELECTED_PICS)
  location       String?
  startAt        DateTime
  endAt          DateTime?
  status         AuditEventStatus        @default(SCHEDULED)
  createdById    String
  createdBy      User                    @relation("AuditEventCreator", fields: [createdById], references: [id])
  participants   AuditEventParticipant[]
  auditReview    AuditReview?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@index([businessUnitId, startAt])
}

model AuditEventParticipant {
  auditEventId   String
  userId         String
  responseStatus AttendanceStatus @default(INVITED)
  respondedAt    DateTime?
  attendedAt     DateTime?
  auditEvent     AuditEvent       @relation(fields: [auditEventId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime         @default(now())

  @@id([auditEventId, userId])
  @@index([userId])
}

// A document is issued either by one Business Unit or by an Organization
// Group (holding) that covers several. Mirrors OrganizationStructure's
// scopeType, which already solved the same modelling problem for People, so
// both menus read the same way.
//
// A Group document does NOT satisfy a Business Unit's mandatory-document
// requirement: the compliance matrix stays strictly per-Business-Unit, and a
// BU's own document always takes precedence over its Group's for that BU.
model SopDocument {
  id                    String                 @id @default(cuid())
  scopeType             SopDocumentScope       @default(BUSINESS_UNIT)
  businessUnitId        String?
  businessUnit          BusinessUnit?          @relation(fields: [businessUnitId], references: [id])
  organizationGroupId   String?
  organizationGroup     OrganizationGroup?     @relation(fields: [organizationGroupId], references: [id])
  ownerId               String?
  owner                 User?                  @relation("DocumentOwner", fields: [ownerId], references: [id])
  documentTypeId        String?
  documentType          DocumentType?          @relation(fields: [documentTypeId], references: [id])
  categoryId            String?
  category              SopCategory?           @relation(fields: [categoryId], references: [id])
  title                 String
  language              String                 @default("id")
  status                SopStatus              @default(DRAFT)
  currentVersion        String?
  versions              SopVersion[]           @relation("SopDocumentVersions")
  publishedVersionId    String?                @unique
  publishedVersion      SopVersion?            @relation("SopDocumentPublishedVersion", fields: [publishedVersionId], references: [id], onDelete: SetNull)
  isArchived            Boolean                @default(false)
  archivedAt            DateTime?
  requests              SopRequest[]
  submissionConversions SubmissionConversion[] @relation("SubmissionConversionDocument")
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  auditReviews          AuditReview[]

  @@index([businessUnitId, documentTypeId])
  @@index([organizationGroupId, documentTypeId])
  @@index([categoryId])
}

enum SopDocumentScope {
  BUSINESS_UNIT
  GROUP
}

model SopVersion {
  id                            String                   @id @default(cuid())
  sopDocumentId                 String
  sopDocument                   SopDocument              @relation("SopDocumentVersions", fields: [sopDocumentId], references: [id])
  versionNo                     String
  fileKey                       String?
  fileName                      String?
  fileSize                      Int?
  contentType                   String?
  changeSummary                 String?
  approvalStatus                SopStatus                @default(DRAFT)
  lifecycleState                SopVersionLifecycleState @default(DRAFT)
  approvedAt                    DateTime?
  approvedById                  String?
  approvedBy                    User?                    @relation("VersionApprover", fields: [approvedById], references: [id])
  uploadedAt                    DateTime                 @default(now())
  updatedAt                     DateTime                 @updatedAt
  effectiveAt                   DateTime?
  nextReviewAt                  DateTime?
  reviewIntervalMonths          Int?
  reviewIntervalSource          ReviewIntervalSource?
  reviewOverrideReason          String?
  reviewerId                    String?
  reviewer                      User?                    @relation("SopVersionReviewer", fields: [reviewerId], references: [id])
  submittedAt                   DateTime?
  submittedById                 String?
  submittedBy                   User?                    @relation("SopVersionSubmitter", fields: [submittedById], references: [id])
  contentHash                   String?
  // Outcome of the last chatbot content-indexing attempt, so the Repository
  // UI can tell "not processed yet" apart from "cannot be processed". Both
  // null means never attempted; contentIndexedAt set means searchable;
  // contentIndexSkipReason set means a known format limitation (scanned PDF,
  // DOCX) that re-running will never fix.
  contentIndexedAt              DateTime?
  contentIndexSkipReason        String?
  publishedForDocument          SopDocument?             @relation("SopDocumentPublishedVersion")
  refinementJobs                RefinementJob[]
  refinementSessions            RefinementSession[]
  refinementFindings            RefinementFinding[]
  validationDecisions           ValidationDecision[]
  publishingRecords             PublishingRecord[]
  auditReviews                  AuditReview[]
  generatedSubmissionConversion SubmissionConversion?    @relation("SubmissionConversionResultVersion")
  sourceSubmissionConversions   SubmissionConversion[]   @relation("SubmissionConversionSourceVersion")
  sections                      SopSection[]

  @@unique([sopDocumentId, versionNo])
  @@index([lifecycleState])
  @@index([nextReviewAt])
  @@index([reviewerId])
  @@index([submittedById])
}

// One row per extracted PDF page of an approved SOP version, searched by the
// AI Copilot chatbot (lib/ai/chat/retrievers/sop-content.js). searchVector is
// a generated tsvector column added via raw SQL in the migration -- Prisma
// cannot model tsvector directly, same approach already used for pgvector
// (see prisma/migrations/20260803000000_enable_pgvector).
model SopSection {
  id             String     @id @default(cuid())
  sopVersionId   String
  sopVersion     SopVersion @relation(fields: [sopVersionId], references: [id], onDelete: Cascade)
  pageNumber     Int
  text           String
  characterCount Int
  createdAt      DateTime   @default(now())

  // Indexing is delete-then-create in one transaction, which is idempotent
  // for sequential runs -- but two runs for the SAME version executing
  // concurrently (e.g. the backfill button clicked twice before the worker
  // finishes) could interleave under READ COMMITTED such that both insert.
  // This constraint makes that physically impossible: the second concurrent
  // transaction conflicts and aborts, leaving exactly one clean set of pages.
  @@unique([sopVersionId, pageNumber])
  @@index([sopVersionId])
}

model DocumentType {
  id        String        @id @default(cuid())
  code      String        @unique
  name      String        @unique
  category  String
  sortOrder Int
  documents SopDocument[]
  createdAt DateTime      @default(now())
}

model SopRequest {
  id                      String                    @id @default(cuid())
  clientRequestKey        String?                   @unique
  requesterId             String
  requester               User                      @relation("Requester", fields: [requesterId], references: [id])
  sopDocumentId           String?
  sopDocument             SopDocument?              @relation(fields: [sopDocumentId], references: [id])
  requestedBusinessUnitId String?
  requestedBusinessUnit   BusinessUnit?             @relation("RequestedSopBusinessUnit", fields: [requestedBusinessUnitId], references: [id])
  conversionIntent        SubmissionConversionMode?
  title                   String
  requestType             String
  description             String?
  changeType              String?
  clauseReference         String?
  currentText             String?
  proposedText            String?
  businessImpact          String?
  priority                String                    @default("MEDIUM")
  reviewerComment         String?
  reviewedAt              DateTime?
  status                  RequestStatus             @default(SUBMITTED)
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  findings                Finding[]
  messages                RequestMessage[]
  conversion              SubmissionConversion?

  @@index([requestedBusinessUnitId])
}

model SubmissionConversion {
  id              String                   @id @default(cuid())
  requestId       String                   @unique
  request         SopRequest               @relation(fields: [requestId], references: [id], onDelete: Restrict)
  mode            SubmissionConversionMode
  sopDocumentId   String
  sopDocument     SopDocument              @relation("SubmissionConversionDocument", fields: [sopDocumentId], references: [id], onDelete: Restrict)
  sopVersionId    String                   @unique
  sopVersion      SopVersion               @relation("SubmissionConversionResultVersion", fields: [sopVersionId], references: [id], onDelete: Restrict)
  sourceVersionId String?
  sourceVersion   SopVersion?              @relation("SubmissionConversionSourceVersion", fields: [sourceVersionId], references: [id], onDelete: Restrict)
  convertedById   String
  convertedBy     User                     @relation("SubmissionConversionActor", fields: [convertedById], references: [id], onDelete: Restrict)
  convertedAt     DateTime                 @default(now())

  @@index([sopDocumentId])
  @@index([sourceVersionId])
  @@index([convertedById])
}

model RequestMessage {
  id            String               @id @default(cuid())
  requestId     String
  request       SopRequest           @relation(fields: [requestId], references: [id], onDelete: Cascade)
  senderId      String
  sender        User                 @relation(fields: [senderId], references: [id])
  body          String
  createdAt     DateTime             @default(now())
  notifications TicketNotification[]
}

model TicketNotification {
  id          String         @id @default(cuid())
  messageId   String
  message     RequestMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User           @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  readAt      DateTime?
  createdAt   DateTime       @default(now())

  @@unique([messageId, recipientId])
}

model Finding {
  id              String        @id @default(cuid())
  requestId       String?
  request         SopRequest?   @relation(fields: [requestId], references: [id])
  auditReviewId   String?
  auditReview     AuditReview?  @relation(fields: [auditReviewId], references: [id])
  title           String
  evidence        String
  recommendation  String
  risk            RiskLevel
  status          FindingStatus @default(PENDING)
  reviewerComment String?
  actions         ActionItem[]
  createdAt       DateTime      @default(now())

  @@index([requestId])
  @@index([auditReviewId])
}

model ActionItem {
  id                  String             @id @default(cuid())
  findingId           String?
  finding             Finding?           @relation(fields: [findingId], references: [id])
  refinementFindingId String?
  refinementFinding   RefinementFinding? @relation(fields: [refinementFindingId], references: [id])
  ownerId             String
  owner               User               @relation("ActionOwner", fields: [ownerId], references: [id])
  title               String
  dueDate             DateTime?
  status              ActionStatus       @default(OPEN)
  createdAt           DateTime           @default(now())

  @@index([refinementFindingId])
}

model ReferenceSource {
  id                          String                       @id @default(cuid())
  title                       String
  type                        String
  fileKey                     String?
  sourceUrl                   String?
  effectiveDate               DateTime?
  contentHash                 String?
  isApproved                  Boolean                      @default(false)
  approvedAt                  DateTime?
  createdAt                   DateTime                     @default(now())
  refinementSessionReferences RefinementSessionReference[]
}

model RefinementJob {
  id                String              @id @default(cuid())
  sopVersionId      String
  requestedById     String
  businessUnitId    String
  fingerprint       String
  status            RefinementJobStatus @default(QUEUED)
  provider          AiProvider?
  model             String?
  promptVersion     String?
  configurationJson Json?
  startedAt         DateTime?
  completedAt       DateTime?
  errorType         String?
  errorMessage      String?
  sopVersion        SopVersion          @relation(fields: [sopVersionId], references: [id], onDelete: Cascade)
  requestedBy       User                @relation("RefinementJobRequester", fields: [requestedById], references: [id])
  businessUnit      BusinessUnit        @relation(fields: [businessUnitId], references: [id])
  findings          RefinementFinding[]
  aiUsages          AiUsage[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([sopVersionId])
  @@index([businessUnitId])
  @@index([requestedById])
  @@index([fingerprint])
  @@index([status])
  @@index([createdAt])
}

model RefinementSession {
  id             String                       @id @default(cuid())
  sopVersionId   String
  businessUnitId String
  startedById    String
  cycleNo        Int
  mode           String                       @default("HUMAN_ONLY")
  status         RefinementSessionStatus      @default(NEW)
  summary        String?
  startedAt      DateTime?
  completedAt    DateTime?
  sopVersion     SopVersion                   @relation(fields: [sopVersionId], references: [id], onDelete: Cascade)
  businessUnit   BusinessUnit                 @relation(fields: [businessUnitId], references: [id])
  startedBy      User                         @relation(fields: [startedById], references: [id])
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt
  references     RefinementSessionReference[]
  humanFindings  HumanRefinementFinding[]

  @@unique([sopVersionId, cycleNo])
  @@index([businessUnitId, status])
}

model HumanRefinementFinding {
  id                     String                         @id @default(cuid())
  refinementSessionId    String
  title                  String
  category               HumanRefinementFindingCategory
  categoryExplanation    String?
  severity               HumanRefinementSeverity
  observation            String
  documentLocation       String?
  blocking               Boolean                        @default(false)
  blockingOverrideReason String?
  riskImpact             String?
  recommendation         String?
  ownerId                String?
  followUpRequired       Boolean                        @default(false)
  followUpSuggestedOwner String?
  followUpTargetAt       DateTime?
  followUpNote           String?
  status                 HumanRefinementFindingStatus   @default(OPEN)
  resolutionType         HumanRefinementResolutionType?
  resolutionSummary      String?
  resolvedById           String?
  resolvedAt             DateTime?
  deferReason            String?
  deferOwner             String?
  deferTargetAt          DateTime?
  riskAcknowledgement    String?
  dismissalReason        String?
  createdById            String
  createdAt              DateTime                       @default(now())
  updatedAt              DateTime                       @updatedAt
  refinementSession      RefinementSession              @relation(fields: [refinementSessionId], references: [id], onDelete: Cascade)
  createdBy              User                           @relation(fields: [createdById], references: [id])
  owner                  User?                          @relation("HumanRefinementFindingOwner", fields: [ownerId], references: [id])
  resolvedBy             User?                          @relation("HumanRefinementFindingResolver", fields: [resolvedById], references: [id])
  evidence               HumanRefinementEvidence[]
  clarifications         RefinementClarification[]

  @@index([refinementSessionId, status])
  @@index([ownerId])
}

model HumanRefinementEvidence {
  id               String                      @id @default(cuid())
  findingId        String
  type             HumanRefinementEvidenceType
  title            String?
  description      String
  excerpt          String?
  source           String?
  documentLocation String?
  attachmentKey    String?
  addedById        String
  createdAt        DateTime                    @default(now())
  finding          HumanRefinementFinding      @relation(fields: [findingId], references: [id], onDelete: Cascade)
  addedBy          User                        @relation(fields: [addedById], references: [id])

  @@index([findingId, createdAt])
}

model RefinementClarification {
  id                      String                        @id @default(cuid())
  findingId               String
  requestedById           String
  requestedBusinessUnitId String
  question                String
  response                String?
  responseEvidence        String?
  status                  RefinementClarificationStatus @default(OPEN)
  dueAt                   DateTime?
  respondedById           String?
  respondedAt             DateTime?
  closedById              String?
  closedAt                DateTime?
  updatedAt               DateTime                      @updatedAt
  finding                 HumanRefinementFinding        @relation(fields: [findingId], references: [id], onDelete: Cascade)
  requestedBy             User                          @relation("ClarificationRequester", fields: [requestedById], references: [id])
  requestedBusinessUnit   BusinessUnit                  @relation(fields: [requestedBusinessUnitId], references: [id])
  respondedBy             User?                         @relation("ClarificationResponder", fields: [respondedById], references: [id])
  closedBy                User?                         @relation("ClarificationCloser", fields: [closedById], references: [id])

  @@index([findingId, status])
  @@index([requestedBusinessUnitId, status])
}

model RefinementSessionReference {
  id                  String            @id @default(cuid())
  refinementSessionId String
  referenceSourceId   String
  active              Boolean           @default(true)
  relevanceNote       String?
  createdAt           DateTime          @default(now())
  refinementSession   RefinementSession @relation(fields: [refinementSessionId], references: [id], onDelete: Cascade)
  referenceSource     ReferenceSource   @relation(fields: [referenceSourceId], references: [id])

  @@unique([refinementSessionId, referenceSourceId])
}

model RefinementFinding {
  id                  String                       @id @default(cuid())
  refinementJobId     String
  sopVersionId        String
  category            String
  severity            RiskLevel
  currentState        String?
  gap                 String
  recommendation      String
  confidence          Float?
  evidenceJson        Json?
  humanStatus         RefinementFindingHumanStatus @default(PENDING)
  refinementJob       RefinementJob                @relation(fields: [refinementJobId], references: [id], onDelete: Cascade)
  sopVersion          SopVersion                   @relation(fields: [sopVersionId], references: [id], onDelete: Cascade)
  validationDecisions ValidationDecision[]
  actionItems         ActionItem[]
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt

  @@index([refinementJobId])
  @@index([sopVersionId])
  @@index([humanStatus])
  @@index([severity])
}

model ValidationDecision {
  id                      String                   @id @default(cuid())
  sopVersionId            String
  refinementFindingId     String?
  reviewerId              String
  decision                ValidationDecisionType
  comment                 String?
  previousLifecycleState  SopVersionLifecycleState
  resultingLifecycleState SopVersionLifecycleState
  metadataJson            Json?
  sopVersion              SopVersion               @relation(fields: [sopVersionId], references: [id], onDelete: Cascade)
  refinementFinding       RefinementFinding?       @relation(fields: [refinementFindingId], references: [id])
  reviewer                User                     @relation(fields: [reviewerId], references: [id])
  createdAt               DateTime                 @default(now())

  @@index([sopVersionId])
  @@index([refinementFindingId])
  @@index([reviewerId])
  @@index([createdAt])
}

model PublishingRecord {
  id                String           @id @default(cuid())
  sopVersionId      String
  status            PublishingStatus @default(NOT_READY)
  externalSystem    String           @default("IMEMO")
  externalReference String?
  externalUrl       String?
  publishedAt       DateTime?
  publishedById     String?
  notes             String?
  errorMessage      String?
  sopVersion        SopVersion       @relation(fields: [sopVersionId], references: [id], onDelete: Cascade)
  publishedBy       User?            @relation("PublishingRecordPublisher", fields: [publishedById], references: [id])
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([sopVersionId])
  @@index([status])
  @@index([publishedById])
}

model AuditReview {
  id              String            @id @default(cuid())
  sopDocumentId   String
  sopVersionId    String?
  businessUnitId  String
  auditEventId    String?           @unique
  ownerId         String
  status          AuditReviewStatus @default(SCHEDULED)
  dueAt           DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  completionNotes String?
  sopDocument     SopDocument       @relation(fields: [sopDocumentId], references: [id], onDelete: Cascade)
  sopVersion      SopVersion?       @relation(fields: [sopVersionId], references: [id])
  businessUnit    BusinessUnit      @relation(fields: [businessUnitId], references: [id])
  auditEvent      AuditEvent?       @relation(fields: [auditEventId], references: [id])
  owner           User              @relation("AuditReviewOwner", fields: [ownerId], references: [id])
  findings        Finding[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([sopDocumentId])
  @@index([sopVersionId])
  @@index([businessUnitId])
  @@index([ownerId])
  @@index([status])
  @@index([dueAt])
}

model AiUsage {
  id                String         @id @default(cuid())
  userId            String?
  businessUnitId    String?
  feature           AiFeature
  provider          AiProvider
  model             String
  promptVersion     String?
  requestTimestamp  DateTime
  responseTimestamp DateTime?
  latencyMs         Int?
  inputTokens       Int?
  outputTokens      Int?
  totalTokens       Int?
  /// USD per 1,000,000 tokens; serialize as a decimal string at API boundaries.
  estimatedCost     Decimal?       @db.Decimal(20, 10)
  costCurrency      String         @default("USD")
  pricingVersion    String?
  /// USD per 1,000,000 input tokens; serialize as a decimal string at API boundaries.
  pricingInputRate  Decimal?       @db.Decimal(20, 10)
  /// USD per 1,000,000 output tokens; serialize as a decimal string at API boundaries.
  pricingOutputRate Decimal?       @db.Decimal(20, 10)
  success           Boolean        @default(false)
  errorType         String?
  fallbackUsed      Boolean        @default(false)
  refinementJobId   String?
  user              User?          @relation(fields: [userId], references: [id])
  businessUnit      BusinessUnit?  @relation(fields: [businessUnitId], references: [id])
  refinementJob     RefinementJob? @relation(fields: [refinementJobId], references: [id])
  events            AiEvent[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([userId])
  @@index([businessUnitId])
  @@index([feature])
  @@index([provider])
  @@index([refinementJobId])
  @@index([createdAt])
}

model AiEvent {
  id             String        @id @default(cuid())
  aiUsageId      String?
  userId         String?
  businessUnitId String?
  feature        AiFeature
  eventType      AiEventType
  provider       AiProvider?
  model          String?
  reason         String?
  metadataJson   Json?
  aiUsage        AiUsage?      @relation(fields: [aiUsageId], references: [id], onDelete: SetNull)
  user           User?         @relation(fields: [userId], references: [id])
  businessUnit   BusinessUnit? @relation(fields: [businessUnitId], references: [id])
  createdAt      DateTime      @default(now())

  @@index([aiUsageId])
  @@index([userId])
  @@index([businessUnitId])
  @@index([feature])
  @@index([eventType])
  @@index([createdAt])
}

// A UAT-quality and audit log of chatbot exchanges. This is intentionally
// separate from AiUsage: AiUsage is the metered-cost record and never holds
// question/answer text; these two models hold the literal conversation so a
// reviewer can see what was asked, where an answer came back empty or wrong,
// and what a decision-maker was told. Retention is operational, not
// architectural -- see scripts/purge-chat-transcripts.js.
model AiChatConversation {
  id             String           @id @default(cuid())
  userId         String
  businessUnitId String?
  startedAt      DateTime         @default(now())
  lastMessageAt  DateTime         @default(now())
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessUnit   BusinessUnit?    @relation(fields: [businessUnitId], references: [id])
  messages       AiChatMessage[]

  @@index([userId])
  @@index([businessUnitId])
  @@index([lastMessageAt])
}

model AiChatMessage {
  id             String             @id @default(cuid())
  conversationId String
  question       String
  answer         String
  /// AI | DATA_SUMMARY | OUT_OF_SCOPE, mirrors the chat service response mode.
  mode           String
  dataAvailable  Boolean
  inScope        Boolean
  topicsJson     Json?
  referencesJson Json?
  conversation   AiChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt      DateTime           @default(now())

  @@index([conversationId])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  entity    String
  entityId  String
  action    String
  detail    String?
  createdAt DateTime @default(now())
}

model StorageIntegration {
  id                    String   @id @default(cuid())
  provider              String   @unique
  folderId              String
  refreshTokenEncrypted String
  connectedAt           DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model GoogleDriveUploadSession {
  id                  String                   @id @default(cuid())
  purpose             GoogleDriveUploadPurpose
  status              GoogleDriveUploadStatus  @default(PENDING)
  // Carries the eventual document's scope through the upload, since the
  // SopDocument row is only created once the worker finishes the transfer.
  scopeType           SopDocumentScope         @default(BUSINESS_UNIT)
  businessUnitId      String?
  organizationGroupId String?
  sopDocumentId       String?
  documentTypeId      String?
  ownerId             String?
  reviewerId          String
  title               String?
  language            String?
  versionNo           String
  expectedFileName    String
  expectedDriveName   String
  expectedFileSize    Int
  contentType         String
  googleDriveParentId String
  changeSummary       String?
  createdById         String
  transientBlobPath   String?
  failureReason       String?
  lastTransferAt      DateTime?
  googleDriveFileId   String?                  @unique
  sopVersionId        String?                  @unique
  expiresAt           DateTime
  completedAt         DateTime?
  createdAt           DateTime                 @default(now())

  @@index([status, expiresAt])
  @@index([businessUnitId, status])
  @@index([sopDocumentId, status])
  @@index([createdById, status])
}
