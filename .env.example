DATABASE_URL="postgresql://procurement:procurement@postgres:5432/procurement?schema=public"
# docker compose memakai Postgres lokal di atas secara default. Untuk override
# secara sengaja saja, isi DOCKER_DATABASE_URL pada .env lokal Anda.
DOCKER_DATABASE_URL=""
AUTH_SECRET="change-me-to-a-long-random-secret"
# Production (Vercel + Neon): gunakan connection string pooled Neon dengan sslmode=require.
# Jangan pernah commit nilai production ke file .env atau Git.
# Untuk bootstrap pertama kali saja (jalankan lokal, bukan di Vercel):
# BOOTSTRAP_ADMIN_EMAIL="admin@company.com"
# BOOTSTRAP_ADMIN_PASSWORD="minimal-12-karakter"
# BOOTSTRAP_ADMIN_NAME="Nama Administrator"

# Google Drive adalah storage dokumen aplikasi untuk lokal dan Vercel.
STORAGE_PROVIDER="google-drive"
# Jangan commit secret ini.
GOOGLE_DRIVE_CLIENT_ID=""
GOOGLE_DRIVE_CLIENT_SECRET=""
GOOGLE_DRIVE_REDIRECT_URI="http://localhost:3000/api/integrations/google-drive/callback"
GOOGLE_DRIVE_TOKEN_ENCRYPTION_KEY="" # Buat dengan: openssl rand -base64 32

# Private Vercel Blob transit untuk upload SOP besar. File dipindahkan ke Google
# Drive oleh worker lalu dihapus dari Blob. Nilai ini wajib tersedia di Vercel
# dan di environment Trigger.dev, tetapi tidak pernah di browser.
BLOB_READ_WRITE_TOKEN=""

# Trigger.dev background workers for Refinement.
# Ambil DEV secret key dari Trigger.dev dashboard. Jangan commit secret asli.
TRIGGER_PROJECT_ID="proj_ixdmfhoziibhqkwvfqni"
TRIGGER_SECRET_KEY=""

# AI runtime for Chatbot and Refinement. Supported: `anthropic-api`, `zai`.
# Claude Free/Pro/Max subscription credentials, and the z.ai GLM Coding Plan,
# may not be used to serve application users -- both are sold for use inside a
# coding tool, not as a general application API -- so `claude-max-agent` has no
# deployable implementation. Use a pay-per-token API credential instead.
AI_PROVIDER="anthropic-api"

# Feature kill switches. A feature is ON unless the value is explicitly "false".
AI_CHAT_ENABLED="true"
AI_REFINEMENT_ENABLED="true"

# Chatbot answering mode.
#   ai            - answers through the configured provider (default)
#   data-summary  - answers deterministically from retrieved records, no
#                   provider call, labelled in the interface as not being AI.
#                   Use where no API credential is funded yet.
AI_CHAT_MODE="ai"

# AI request budget. Optional; the defaults below are applied when unset.
AI_MAX_CONTEXT_TOKENS="60000"
AI_REQUEST_TIMEOUT_MS="45000"
AI_CHAT_RATE_LIMIT_PER_MINUTE="10"

# AI providers for Chatbot and Refinement.
# Do not expose these keys to browsers, client DTOs, or Git.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5"

# z.ai (GLM) pay-per-token API. Used when AI_PROVIDER=zai. Get a key from the
# z.ai console; make sure it is the pay-per-token API key, not a GLM Coding
# Plan credential -- the Coding Plan is not licensed for a deployed application.
ZAI_API_KEY=""
ZAI_MODEL="glm-4.7"
ZAI_BASE_URL="https://api.z.ai/api/paas/v4"

OPENAI_API_KEY=""
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
OPENAI_EMBEDDING_DIMENSIONS="1536"
